import { router } from '@inertiajs/react';
import { BadgeDollarSign, FileText, FolderKanban, MapPin, UserRound } from 'lucide-react';
import { AppBadge } from '@/components/ui/AppBadge';
import { AppButton } from '@/components/ui/AppButton';
import { AppCard } from '@/components/ui/AppCard';
import { AppEmptyState } from '@/components/ui/AppEmptyState';
import { AppStatusBadge } from '@/components/ui/AppStatusBadge';
import type { DossierCommuneGroup, DossierLocationGroup, DossierLocationRow, DossierLocationStats } from '@/features/dossiers/types';

type DossierLocationExplorerProps = {
    groups: DossierLocationGroup[];
};

type Tone = 'neutral' | 'blue' | 'green' | 'amber' | 'red' | 'violet';

function formatMoney(value: number) {
    return new Intl.NumberFormat('fr-MA', {
        style: 'currency',
        currency: 'MAD',
        maximumFractionDigits: 0,
    }).format(value || 0);
}

function statusTone(status: string): Tone {
    switch (status) {
        case 'active':
        case 'opened':
            return 'green';
        case 'closed':
            return 'neutral';
        case 'archived':
            return 'violet';
        default:
            return 'amber';
    }
}

function StatPill({ label, value }: { label: string; value: string | number }) {
    return (
        <div className="rounded-xl bg-[var(--surface-2)] px-3 py-2">
            <p className="text-[10px] uppercase tracking-[0.16em] text-[var(--text-muted)]">{label}</p>
            <p className="mt-1 text-sm font-semibold">{value}</p>
        </div>
    );
}

function GroupStats({ stats }: { stats: DossierLocationStats }) {
    return (
        <div className="grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
            <StatPill label="Projets" value={stats.projectsCount} />
            <StatPill label="Documents" value={stats.documentsCount} />
            <StatPill label="Factures" value={formatMoney(stats.invoicesTotal)} />
            <StatPill label="Paye" value={formatMoney(stats.paidTotal)} />
        </div>
    );
}

function ProjectRow({ dossier }: { dossier: DossierLocationRow }) {
    return (
        <div className="rounded-2xl border bg-[var(--surface)] p-4">
            <div className="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
                <div className="min-w-0">
                    <div className="flex flex-wrap items-center gap-2">
                        <div className="flex size-8 shrink-0 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--accent)_12%,transparent)] text-[var(--accent)]">
                            <FolderKanban size={15} />
                        </div>
                        <div className="min-w-0">
                            <p className="truncate text-sm font-semibold">{dossier.projectObject || 'Projet sans objet'}</p>
                            <p className="mt-1 text-xs text-[var(--text-muted)]">{dossier.dossierNumber}</p>
                        </div>
                        <AppStatusBadge label={dossier.status} tone={statusTone(dossier.status)} icon={dossier.status === 'active' ? 'check' : 'dot'} />
                    </div>

                    <div className="mt-3 grid gap-2 text-xs text-[var(--text-muted)] md:grid-cols-2">
                        <span className="inline-flex min-w-0 items-center gap-1">
                            <UserRound size={13} />
                            <span className="truncate">{dossier.ownerName || 'Client non renseigne'}</span>
                        </span>
                        <span className="inline-flex min-w-0 items-center gap-1">
                            <MapPin size={13} />
                            <span className="truncate">{dossier.projectAddress || 'Adresse non renseignee'}</span>
                        </span>
                    </div>
                </div>

                <div className="grid gap-2 sm:grid-cols-4 xl:min-w-[420px]">
                    <StatPill label="Docs" value={dossier.documentsCount} />
                    <StatPill label="Finance" value={dossier.financeDocumentsCount} />
                    <StatPill label="Factures" value={formatMoney(dossier.invoicesTotal)} />
                    <StatPill label="Reste" value={formatMoney(dossier.remainingTotal)} />
                </div>
            </div>

            <div className="mt-4 flex flex-wrap justify-end gap-2">
                <AppButton variant="secondary" size="sm" onPress={() => router.visit(`/clients/${dossier.clientId}?dossier_id=${dossier.id}`)}>
                    <UserRound size={14} />
                    Client
                </AppButton>
                <AppButton variant="secondary" size="sm" onPress={() => router.visit(`/documents?dossier_id=${dossier.id}`)}>
                    <FileText size={14} />
                    Documents
                </AppButton>
                <AppButton variant="secondary" size="sm" onPress={() => router.visit(`/finance/documents?dossier_id=${dossier.id}`)}>
                    <BadgeDollarSign size={14} />
                    Finance
                </AppButton>
                <AppButton variant="primary" size="sm" onPress={() => router.visit(`/dossiers/${dossier.id}`)}>
                    Ouvrir
                </AppButton>
            </div>
        </div>
    );
}

function CommuneSection({ commune }: { commune: DossierCommuneGroup }) {
    return (
        <details className="group rounded-2xl border bg-[var(--surface)] p-4" open>
            <summary className="flex cursor-pointer list-none flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 className="text-sm font-semibold">{commune.commune}</h3>
                    <p className="mt-1 text-xs text-[var(--text-muted)]">
                        {commune.stats.projectsCount} projets - {commune.stats.openCount} ouverts - {commune.stats.closedCount} clotures
                    </p>
                </div>
                <AppBadge tone="blue">{formatMoney(commune.stats.remainingTotal)} reste</AppBadge>
            </summary>

            <div className="mt-4 space-y-3">
                {commune.dossiers.map((dossier) => (
                    <ProjectRow key={dossier.id} dossier={dossier} />
                ))}
            </div>
        </details>
    );
}

export function DossierLocationExplorer({ groups }: DossierLocationExplorerProps) {
    if (groups.length === 0) {
        return (
            <AppEmptyState
                title="Aucun projet a organiser"
                description="Les projets apparaitront ici par province et commune."
                icon={<MapPin size={20} />}
            />
        );
    }

    return (
        <div className="space-y-5">
            {groups.map((group) => (
                <AppCard key={group.province} className="p-5">
                    <div className="mb-4 flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
                        <div>
                            <div className="flex items-center gap-2">
                                <MapPin size={17} className="text-[var(--accent)]" />
                                <h2 className="text-base font-semibold">{group.province}</h2>
                            </div>
                            <p className="mt-1 text-sm text-[var(--text-muted)]">
                                Projets groupes par commune avec proprietaire, documents et finance.
                            </p>
                        </div>
                        <div className="xl:min-w-[520px]">
                            <GroupStats stats={group.stats} />
                        </div>
                    </div>

                    <div className="space-y-3">
                        {group.communes.map((commune) => (
                            <CommuneSection key={`${group.province}-${commune.commune}`} commune={commune} />
                        ))}
                    </div>
                </AppCard>
            ))}
        </div>
    );
}
