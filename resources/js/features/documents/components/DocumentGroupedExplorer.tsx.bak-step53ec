import { router } from '@inertiajs/react';
import { ChevronDown, Download, Eye, FileCheck2, FileText, FolderKanban, Map, MapPin, UserRound } from 'lucide-react';
import { useState } from 'react';
import { AppBadge } from '@/components/ui/AppBadge';
import { AppButton } from '@/components/ui/AppButton';
import { AppCard } from '@/components/ui/AppCard';
import { AppEmptyState } from '@/components/ui/AppEmptyState';
import { AppStatusBadge } from '@/components/ui/AppStatusBadge';
import type {
    DocumentClientGroup,
    DocumentCommuneGroup,
    DocumentGroupStats,
    DocumentLocationGroup,
    DocumentProjectGroup,
    DocumentStatus,
    DocumentTypeGroup,
} from '@/features/documents/types';

type Props = {
    groups: DocumentLocationGroup[];
};

type BadgeTone = 'neutral' | 'blue' | 'green' | 'amber' | 'red' | 'violet';
type StatusIcon = 'dot' | 'check' | 'clock' | 'warning';

function statusTone(status: DocumentStatus): BadgeTone {
    if (status === 'verified') return 'green';
    if (status === 'uploaded') return 'blue';
    if (status === 'missing') return 'amber';
    if (status === 'rejected') return 'red';

    return 'neutral';
}

function statusIcon(status: DocumentStatus): StatusIcon {
    if (status === 'verified') return 'check';
    if (status === 'uploaded') return 'clock';
    if (status === 'missing' || status === 'rejected') return 'warning';

    return 'dot';
}

function StatStrip({ stats }: { stats: DocumentGroupStats }) {
    const items = [
        ['Documents', stats.documentsCount],
        ['Uploaded', stats.uploadedCount],
        ['Verified', stats.verifiedCount],
        ['Missing', stats.missingCount],
        ['Rejected', stats.rejectedCount],
    ];

    return (
        <div className="grid gap-2 sm:grid-cols-2 xl:grid-cols-5">
            {items.map(([label, value]) => (
                <div key={label} className="rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 py-2">
                    <p className="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--text-muted)]">{label}</p>
                    <p className="mt-1 text-sm font-semibold">{value}</p>
                </div>
            ))}
        </div>
    );
}

function TypeGroup({ group }: { group: DocumentTypeGroup }) {
    const [open, setOpen] = useState(true);

    return (
        <AppCard className="overflow-hidden p-0">
            <button
                type="button"
                onClick={() => setOpen((value) => !value)}
                className="flex w-full items-center justify-between gap-3 px-3 py-3 text-left transition hover:bg-[var(--surface-2)]"
            >
                <span className="flex min-w-0 items-center gap-2">
                    <FileText size={15} className="shrink-0 text-[var(--accent)]" />
                    <span className="truncate text-sm font-semibold">{group.type}</span>
                    <AppBadge tone="blue">{group.stats.documentsCount} docs</AppBadge>
                </span>
                <ChevronDown size={15} className={open ? 'shrink-0 transition' : 'shrink-0 -rotate-90 transition'} />
            </button>

            {open ? (
                <div className="space-y-2 border-t border-[var(--border)] p-3">
                    {group.documents.map((document) => (
                        <div
                            key={document.id}
                            className="grid gap-3 rounded-xl border border-[var(--border)] bg-[var(--surface)] p-3 lg:grid-cols-[minmax(0,1fr)_180px_auto]"
                        >
                            <div className="min-w-0">
                                <p className="truncate text-sm font-semibold">{document.templateName || document.originalFilename || 'Document'}</p>
                                <p className="mt-1 text-xs text-[var(--text-muted)]">{document.documentNumber || 'No number'}</p>
                                <p className="mt-1 truncate text-xs text-[var(--text-muted)]">{document.originalFilename || '-'}</p>
                            </div>

                            <div>
                                <AppStatusBadge label={document.status} tone={statusTone(document.status)} icon={statusIcon(document.status)} />
                                <p className="mt-2 text-xs text-[var(--text-muted)]">{document.uploadedAt || '-'}</p>
                            </div>

                            <div className="flex items-center gap-2 lg:justify-end">
                                <AppButton variant="secondary" onPress={() => router.visit(`/dossiers/${document.dossierId}`)}>
                                    <Eye size={15} />
                                    Project
                                </AppButton>
                                <AppButton variant="ghost" onPress={() => window.location.assign(`/documents/${document.id}/download`)}>
                                    <Download size={15} />
                                </AppButton>
                            </div>
                        </div>
                    ))}
                </div>
            ) : null}
        </AppCard>
    );
}

function ProjectGroup({ group }: { group: DocumentProjectGroup }) {
    const [open, setOpen] = useState(true);

    return (
        <AppCard className="overflow-hidden p-0">
            <button
                type="button"
                onClick={() => setOpen((value) => !value)}
                className="flex w-full items-center justify-between gap-3 px-3 py-3 text-left transition hover:bg-[var(--surface-2)]"
            >
                <span className="flex min-w-0 items-center gap-2">
                    <FolderKanban size={15} className="shrink-0 text-[var(--accent)]" />
                    <span className="min-w-0">
                        <span className="block truncate text-sm font-semibold">{group.projectObject || group.dossierNumber}</span>
                        <span className="text-xs text-[var(--text-muted)]">{group.dossierNumber}</span>
                    </span>
                </span>
                <ChevronDown size={15} className={open ? 'shrink-0 transition' : 'shrink-0 -rotate-90 transition'} />
            </button>

            {open ? (
                <div className="space-y-3 border-t border-[var(--border)] p-3">
                    <StatStrip stats={group.stats} />
                    {group.types.map((type) => (
                        <TypeGroup key={`${group.dossierNumber}-${type.type}`} group={type} />
                    ))}
                </div>
            ) : null}
        </AppCard>
    );
}

function ClientGroup({ group }: { group: DocumentClientGroup }) {
    const [open, setOpen] = useState(true);

    return (
        <AppCard className="overflow-hidden p-0">
            <button
                type="button"
                onClick={() => setOpen((value) => !value)}
                className="flex w-full items-center justify-between gap-3 px-3 py-3 text-left transition hover:bg-[var(--surface-2)]"
            >
                <span className="flex min-w-0 items-center gap-2">
                    <UserRound size={15} className="shrink-0 text-[var(--accent)]" />
                    <span className="truncate text-sm font-semibold">{group.clientName}</span>
                    <AppBadge tone="violet">{group.stats.documentsCount} docs</AppBadge>
                </span>
                <ChevronDown size={15} className={open ? 'shrink-0 transition' : 'shrink-0 -rotate-90 transition'} />
            </button>

            {open ? (
                <div className="space-y-3 border-t border-[var(--border)] p-3">
                    {group.projects.map((project) => (
                        <ProjectGroup key={`${group.clientName}-${project.dossierNumber}`} group={project} />
                    ))}
                </div>
            ) : null}
        </AppCard>
    );
}

function CommuneGroup({ group }: { group: DocumentCommuneGroup }) {
    const [open, setOpen] = useState(true);

    return (
        <AppCard className="overflow-hidden p-0">
            <button
                type="button"
                onClick={() => setOpen((value) => !value)}
                className="flex w-full items-center justify-between gap-3 px-4 py-3 text-left transition hover:bg-[var(--surface-2)]"
            >
                <span className="flex min-w-0 items-center gap-3">
                    <span className="flex size-9 shrink-0 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--accent)_12%,transparent)] text-[var(--accent)]">
                        <MapPin size={16} />
                    </span>
                    <span className="min-w-0">
                        <span className="block truncate text-sm font-semibold">{group.commune}</span>
                        <span className="text-xs text-[var(--text-muted)]">{group.clients.length} client(s) · {group.stats.documentsCount} document(s)</span>
                    </span>
                </span>
                <ChevronDown size={16} className={open ? 'shrink-0 transition' : 'shrink-0 -rotate-90 transition'} />
            </button>

            {open ? (
                <div className="space-y-3 border-t border-[var(--border)] p-4">
                    <StatStrip stats={group.stats} />
                    {group.clients.map((client) => (
                        <ClientGroup key={`${group.commune}-${client.clientName}`} group={client} />
                    ))}
                </div>
            ) : null}
        </AppCard>
    );
}

function ProvinceGroup({ group }: { group: DocumentLocationGroup }) {
    const [open, setOpen] = useState(true);

    return (
        <AppCard className="overflow-hidden p-0">
            <button
                type="button"
                onClick={() => setOpen((value) => !value)}
                className="flex w-full items-center justify-between gap-3 px-4 py-4 text-left transition hover:bg-[var(--surface-2)]"
            >
                <span className="flex min-w-0 items-center gap-3">
                    <span className="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--accent)_14%,transparent)] text-[var(--accent)]">
                        <Map size={17} />
                    </span>
                    <span className="min-w-0">
                        <span className="block truncate text-base font-semibold">{group.province}</span>
                        <span className="text-xs text-[var(--text-muted)]">{group.communes.length} commune(s) · {group.stats.documentsCount} document(s)</span>
                    </span>
                </span>
                <ChevronDown size={18} className={open ? 'shrink-0 transition' : 'shrink-0 -rotate-90 transition'} />
            </button>

            {open ? (
                <div className="space-y-4 border-t border-[var(--border)] p-4">
                    <StatStrip stats={group.stats} />
                    {group.communes.map((commune) => (
                        <CommuneGroup key={`${group.province}-${commune.commune}`} group={commune} />
                    ))}
                </div>
            ) : null}
        </AppCard>
    );
}

export function DocumentGroupedExplorer({ groups }: Props) {
    if (!groups.length) {
        return (
            <AppEmptyState
                title="No document groups found"
                description="Upload project documents to see province, commune, client, project, and type grouping."
            />
        );
    }

    return (
        <section className="space-y-4">
            <div className="flex items-start gap-3 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-4">
                <div className="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-[color-mix(in_srgb,var(--accent)_10%,transparent)] text-[var(--accent)]">
                    <FileCheck2 size={18} />
                </div>
                <div>
                    <h2 className="text-sm font-semibold">Grouped document explorer</h2>
                    <p className="mt-1 text-sm text-[var(--text-muted)]">
                        Documents are organized by province, commune, client, project, and document type.
                    </p>
                </div>
            </div>

            {groups.map((group) => (
                <ProvinceGroup key={group.province} group={group} />
            ))}
        </section>
    );
}